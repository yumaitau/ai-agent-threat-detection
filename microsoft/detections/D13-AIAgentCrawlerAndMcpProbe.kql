// YUMA-AIA-D13  (DRAFT HUNT) AI crawler or agent user agents enumerating an app, or probing MCP / AI endpoints
// Table: AGWAccessLogs. Licence: Application Gateway diagnostics (resource-specific mode).
//   https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/agwaccesslogs
// User agents are self-declared and spoofable; verify against vendor-published IP ranges (planned watchlist).
// Maps: ISM-2116 | ATT&CK T1595.002, T1593 | ATLAS AML.T0006, AML.T0093 | OWASP LLM10
let lookback = 1d;
let AIAgentUA = dynamic(["GPTBot", "ChatGPT-User", "OAI-SearchBot", "ClaudeBot", "Claude-User", "Claude-SearchBot",
    "PerplexityBot", "Perplexity-User", "Meta-ExternalAgent", "Bytespider", "CCBot", "Google-Extended"]);
let ProbePaths = dynamic(["/mcp", "/sse", "/.well-known/mcp", "/v1/chat/completions", "/v1/completions",
    "/api/generate", "/.well-known/ai-plugin.json", "/openapi.json", "/llms.txt"]);
AGWAccessLogs
| where TimeGenerated > ago(lookback)
| extend ClaimsAIAgent = UserAgent has_any (AIAgentUA),
         IsProbe = tolower(RequestUri) has_any (ProbePaths)
| where ClaimsAIAgent or IsProbe
| summarize Requests = count(), DistinctUris = dcount(RequestUri), NotFound = countif(HttpStatus == 404),
            ProbeHits = countif(IsProbe), UserAgents = make_set(UserAgent, 10), SampleUris = make_set(RequestUri, 20),
            Hosts = make_set(Host, 5), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
         by ClientIp, ClaimsAIAgent
| extend NotFoundRatio = round(todouble(NotFound) / Requests, 2)
| where ProbeHits > 0 or DistinctUris > 200 or NotFoundRatio > 0.5
| order by ProbeHits desc, DistinctUris desc
