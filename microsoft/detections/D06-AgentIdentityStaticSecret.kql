// YUMA-AIA-D06  (DRAFT HUNT) Agent identities and AI service principals authenticating with static client secrets
// Table: AADServicePrincipalSignInLogs. Licence: Entra ID P1/P2 for sign-in log ingestion.
//   https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/aadserviceprincipalsigninlogs
// ClientCredentialType values (clientSecret, clientAssertion, federatedIdentityCredential, managedIdentity, certificate)
//   are from the Graph signIn resource; confirm the exact strings in the tenant. UNVALIDATED.
// Maps: ISM-2141, ISM-2142, ISM-2146 | E8 restrict administrative privileges
//   ATT&CK T1552.001 | ATLAS AML.T0055, AML.T0083 | OWASP ASI03
let lookback = 30d;
let AIKeywords = dynamic(["openai", "chatgpt", "anthropic", "claude", "copilot", "gemini", "perplexity", "mistral",
    "deepseek", "grok", "n8n", "zapier", "langchain", "agent", "mcp"]);
AADServicePrincipalSignInLogs
| where TimeGenerated > ago(lookback)
| extend AgentType = tostring(parse_json(Agent).agentType)
| where (isnotempty(AgentType) and AgentType !~ "notAgentic") or ServicePrincipalName has_any (AIKeywords)
| where ClientCredentialType has "secret"
| summarize SignIns = count(), Resources = make_set(ResourceDisplayName, 20), IPs = make_set(IPAddress, 20),
            CredentialKeyIds = make_set(ServicePrincipalCredentialKeyId, 10), LastSeen = max(TimeGenerated)
         by ServicePrincipalName, ServicePrincipalId, AppId, AgentType, ClientCredentialType
| order by SignIns desc
