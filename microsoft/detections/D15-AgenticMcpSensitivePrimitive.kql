// YUMA-AIA-D15  (DRAFT HUNT) Agentic traffic invoking destructive or sensitive MCP primitives, or new MCP destinations
// Table: NetworkAccessTraffic (Global Secure Access / Entra Internet Access). Agentic columns are recent; confirm
//   population in the tenant. Licence: Entra Internet Access (Global Secure Access).
//   https://learn.microsoft.com/en-us/entra/global-secure-access/how-to-view-traffic-logs
//   https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/networkaccesstraffic
// Maps: ISM-2159 (log tool invocations), ISM-2156, ISM-2113 (human approval) | ATT&CK T1485, T1567
//   ATLAS AML.T0053, AML.T0101, AML.T0086 | OWASP ASI02, LLM06
let lookback = 1d;
let baseline = 14d;
let SensitiveVerbs = @"(?i)(delete|remove|drop|truncate|exec|execute|shell|run_command|send|transfer|payment|write|upload|share|grant)";
let Agentic = NetworkAccessTraffic
    | where TimeGenerated > ago(baseline)
    | where IsAgentic == true;
let KnownMcpDest = Agentic
    | where TimeGenerated <= ago(lookback) and isnotempty(McpProtocolVersion)
    | distinct AIAgentId, DestinationFqdn;
Agentic
| where TimeGenerated > ago(lookback)
| where isnotempty(McpPrimitiveName) or isnotempty(McpProtocolVersion)
| join kind=leftanti KnownMcpDest on AIAgentId, DestinationFqdn
| union (Agentic | where TimeGenerated > ago(lookback) | where McpPrimitiveName matches regex SensitiveVerbs)
| extend IsSensitivePrimitive = McpPrimitiveName matches regex SensitiveVerbs
| summarize Calls = count(), Primitives = make_set(McpPrimitiveName, 20), Destinations = make_set(DestinationFqdn, 10),
            Actions = make_set(Action, 3), SentBytes = sum(SentBytes), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
         by AIAgentId, AIAgentName, AgentPlatform, UserPrincipalName, DeviceId, InitiatingProcessName, IsSensitivePrimitive
| order by IsSensitivePrimitive desc, Calls desc
