// YUMA-GAI-G15  AI agent service account authenticating with a user-managed key from outside Google's network
// Status: DRAFT HUNT. Based on Google's community rule gcp_service_account_key_used_from_multiple_countries
//   (security_result.detection_fields["service_account_key_name"], principal.ip_geo_artifact.network.organization_name).
//   https://github.com/chronicle/detection-rules/tree/main/rules/community/gcp
// Overlap: SCC ETD "Credential Access: Agentic Identity Credential Used Outside of Google Cloud" covers Agent Identity (Premium).
//   This covers agents still on service account keys.
// Maps: ISM-2141, ISM-2144, ISM-2136 | ATT&CK T1078.004 | ATLAS AML.T0012, AML.T0055 | OWASP ASI03
rule yuma_gai_g15_ai_service_account_key_used_off_google {
  meta:
    author = "Yuma IT"
    description = "AI agent service account used a user-managed key from a non-Google network"
    severity = "HIGH"
    yuma_id = "G15"
    ism = "ISM-2141, ISM-2144, ISM-2136"

  events:
    $u.metadata.log_type = "GCP_CLOUDAUDIT"
    $u.security_result.detection_fields["service_account_key_name"] != ""
    $u.principal.user.userid in regex %yuma_ai_service_accounts
    $u.principal.ip_geo_artifact.network.organization_name != /google/ nocase
    $u.principal.user.userid = $sa

  match:
    $sa over 1h

  outcome:
    $key_names = array_distinct($u.security_result.detection_fields["service_account_key_name"])
    $source_ips = array_distinct($u.principal.ip)
    $countries = array_distinct($u.principal.ip_geo_artifact.location.country_or_region)
    $methods = array_distinct($u.metadata.product_event_type)
    $risk_score = max(75)

  condition:
    $u
}
