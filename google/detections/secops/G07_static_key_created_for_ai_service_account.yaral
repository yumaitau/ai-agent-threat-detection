// YUMA-GAI-G07  Long-lived service account key created or uploaded for an AI agent service account
// Status: RULE-GRADE (offline-linted only)
// Log type: GCP_CLOUDAUDIT (Admin Activity). Built on Google's community rule
//   google_cloud_service_account_key_created_or_uploaded (same product_event_type values and key_id field):
//   https://github.com/chronicle/detection-rules/tree/main/rules/community/gcp
// Why it matters: agents should use Agent Identity (no long-lived keys possible) or attached service accounts.
//   https://docs.cloud.google.com/iam/docs/agent-identity-overview
// Reference list: %yuma_ai_service_accounts (REGEX list of AI service account emails AND numeric unique IDs; PB4 maintains it).
//   resourceName on key creation can carry the numeric unique ID rather than the email, so keep both in the list.
// Maps: ISM-2141, ISM-2142, ISM-2146, ISM-2143 | E8 restrict administrative privileges
//   ATT&CK T1098.001 | ATLAS AML.T0012, AML.T0083 | OWASP ASI03
rule yuma_gai_g07_static_key_created_for_ai_service_account {
  meta:
    author = "Yuma IT"
    description = "A user-managed key was created or uploaded for a service account used by an AI agent"
    severity = "HIGH"
    priority = "HIGH"
    yuma_id = "G07"
    ism = "ISM-2141, ISM-2142, ISM-2146, ISM-2143"
    mitre_attack_technique_id = "T1098.001"
    atlas = "AML.T0012, AML.T0083"
    owasp = "ASI03"

  events:
    $k.metadata.log_type = "GCP_CLOUDAUDIT"
    (
      $k.metadata.product_event_type = "google.iam.admin.v1.CreateServiceAccountKey" or
      $k.metadata.product_event_type = "google.iam.admin.v1.UploadServiceAccountKey"
    )
    $k.security_result.action = "ALLOW"
    (
      $k.target.resource.name in regex %yuma_ai_service_accounts
      or $k.target.resource.name = /agent|\bai\b|-ai-|llm|gemini|vertex|mcp|bot|assistant|reasoning/ nocase
    )
    $k.security_result.detection_fields["key_id"] = $sa_key_id

  match:
    $sa_key_id over 30m

  outcome:
    $risk_score = max(75)
    $service_account = array_distinct($k.target.resource.name)
    $created_by = array_distinct($k.principal.user.userid)
    $principal_ip = array_distinct($k.principal.ip)
    $project = array_distinct($k.target.cloud.project.name)
    $method = array_distinct($k.metadata.product_event_type)

  condition:
    $k
}
